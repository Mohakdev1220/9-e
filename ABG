<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>9-E Smartboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}

:root{
  --ink:       #0D0D0D;
  --ink-2:     #1A1A1A;
  --ink-3:     #2A2A2A;
  --line:      rgba(255,255,255,0.08);
  --line-med:  rgba(255,255,255,0.14);
  --amber:     #F5A623;
  --amber-dim: rgba(245,166,35,0.12);
  --white:     #FFFFFF;
  --muted:     rgba(255,255,255,0.45);
  --muted-2:   rgba(255,255,255,0.22);
  --green:     #3DFF8F;
  --red:       #FF4D4D;

  --f-display: 'Space Grotesk', sans-serif;
  --f-mono:    'Space Mono', monospace;
}

html,body{
  width:100vw; height:100vh;
  overflow:hidden;
  background:var(--ink);
  color:var(--white);
  font-family:var(--f-display);
  -webkit-font-smoothing:antialiased;
}

/* ─── LAYOUT ────────────────────────────────── */
.board{
  display:grid;
  grid-template-columns: 1fr 440px;
  grid-template-rows: 72px 1fr;
  height:100vh;
  width:100vw;
  gap:0;
}

/* ─── TOPBAR ─────────────────────────────────── */
.topbar{
  grid-column: 1 / -1;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 36px;
  border-bottom:1px solid var(--line);
  background:var(--ink);
  position:relative;
  z-index:10;
}

.topbar-left{
  display:flex;
  align-items:center;
  gap:20px;
}

.brand-pill{
  background:var(--amber);
  color:var(--ink);
  font-weight:700;
  font-size:16px;
  letter-spacing:-0.3px;
  padding:6px 14px;
  border-radius:6px;
}

.brand-name{
  font-size:22px;
  font-weight:700;
  letter-spacing:-0.5px;
}

.brand-sub{
  font-size:12px;
  color:var(--muted);
  font-weight:500;
  margin-top:1px;
}

.divider-v{
  width:1px;
  height:28px;
  background:var(--line-med);
}

.live-badge{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:12px;
  color:var(--muted);
  font-weight:600;
  letter-spacing:0.3px;
  text-transform:uppercase;
}

.pulse{
  width:8px; height:8px;
  border-radius:50%;
  background:var(--green);
  box-shadow:0 0 0 3px rgba(61,255,143,0.2);
  animation:heartbeat 2s ease-in-out infinite;
}

@keyframes heartbeat{
  0%,100%{box-shadow:0 0 0 3px rgba(61,255,143,0.2)}
  50%{box-shadow:0 0 0 6px rgba(61,255,143,0.05)}
}

.topbar-right{
  display:flex;
  align-items:center;
  gap:28px;
}

.date-display{
  font-size:13px;
  color:var(--muted);
  font-weight:500;
  text-align:right;
}

.clock{
  font-family:var(--f-mono);
  font-size:28px;
  font-weight:700;
  letter-spacing:-1px;
  color:var(--amber);
  line-height:1;
}

/* ─── LEFT: NEWS ──────────────────────────────── */
.news-col{
  border-right:1px solid var(--line);
  display:flex;
  flex-direction:column;
  overflow:hidden;
  position:relative;
}

.news-bg{
  position:absolute;
  inset:0;
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  opacity:0;
  transition:opacity 0.7s ease, transform 10s ease;
  transform:scale(1.04);
  will-change:opacity,transform;
}

.news-bg.loaded{
  opacity:1;
  transform:scale(1);
}

.news-scrim{
  position:absolute;
  inset:0;
  background:linear-gradient(
    to top,
    rgba(0,0,0,0.96) 0%,
    rgba(0,0,0,0.7) 40%,
    rgba(0,0,0,0.1) 100%
  );
  z-index:2;
}

.news-body{
  position:relative;
  z-index:3;
  margin-top:auto;
  padding:44px 48px;
  display:flex;
  flex-direction:column;
}

.news-kicker{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:20px;
}

.news-cat{
  background:var(--amber);
  color:var(--ink);
  font-size:11px;
  font-weight:700;
  letter-spacing:0.8px;
  text-transform:uppercase;
  padding:5px 12px;
  border-radius:4px;
}

.news-src{
  font-size:12px;
  color:var(--muted);
  font-weight:600;
  letter-spacing:0.3px;
}

.news-dot{
  width:3px; height:3px;
  border-radius:50%;
  background:var(--muted-2);
}

.news-headline{
  font-size:clamp(32px, 3.8vw, 64px);
  font-weight:700;
  line-height:1.08;
  letter-spacing:-1.5px;
  max-width:900px;
  margin-bottom:18px;
}

.news-desc{
  font-size:15px;
  color:rgba(255,255,255,0.65);
  line-height:1.6;
  max-width:700px;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
  margin-bottom:28px;
}

.news-actions{
  display:flex;
  align-items:center;
  gap:20px;
}

.read-btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:11px 20px;
  background:var(--amber);
  color:var(--ink);
  border-radius:6px;
  font-size:13px;
  font-weight:700;
  text-decoration:none;
  transition:transform 0.15s ease, opacity 0.15s ease;
}

.read-btn:hover{
  transform:translateY(-2px);
  opacity:0.9;
}

.news-counter{
  display:flex;
  align-items:center;
  gap:10px;
}

.dot-track{
  display:flex;
  gap:5px;
  align-items:center;
}

.dot-item{
  width:5px; height:5px;
  border-radius:50%;
  background:rgba(255,255,255,0.2);
  transition:all 0.3s ease;
}

.dot-item.active{
  width:18px;
  border-radius:3px;
  background:var(--amber);
}

.next-label{
  font-size:12px;
  color:var(--muted);
  font-weight:600;
}

/* Timer arc */
.timer-ring{
  width:36px; height:36px;
  flex-shrink:0;
}

.timer-ring circle{
  fill:none;
  stroke-width:3;
}

.timer-track{
  stroke:rgba(255,255,255,0.1);
}

.timer-fill{
  stroke:var(--amber);
  stroke-linecap:round;
  stroke-dasharray:88;
  stroke-dashoffset:0;
  transition:stroke-dashoffset 0.9s linear;
  transform:rotate(-90deg);
  transform-origin:50% 50%;
}

/* ─── RIGHT SIDEBAR ──────────────────────────── */
.sidebar{
  display:flex;
  flex-direction:column;
  background:var(--ink-2);
  overflow:hidden;
}

/* ─── PANEL BASE ─────────────────────────────── */
.panel{
  padding:24px 28px;
  border-bottom:1px solid var(--line);
  flex-shrink:0;
}

.p-eyebrow{
  font-size:10px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1.2px;
  color:var(--muted);
  margin-bottom:12px;
}

/* ─── WEATHER PANEL ──────────────────────────── */
.weather-panel{}

.weather-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  margin-bottom:18px;
}

.weather-temp{
  font-size:72px;
  font-weight:700;
  letter-spacing:-4px;
  line-height:1;
  color:var(--white);
}

.weather-right{
  text-align:right;
}

.weather-icon-big{
  font-size:46px;
  line-height:1;
  display:block;
  margin-bottom:4px;
}

.weather-cond{
  font-size:13px;
  color:var(--muted);
  font-weight:500;
}

.weather-stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}

.wstat{
  background:var(--ink-3);
  border-radius:8px;
  padding:10px 12px;
  text-align:center;
}

.wstat-val{
  font-size:15px;
  font-weight:700;
  color:var(--amber);
  font-family:var(--f-mono);
}

.wstat-lbl{
  font-size:9px;
  color:var(--muted);
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:0.6px;
  margin-top:3px;
}

/* ─── SCHOOL STATUS ──────────────────────────── */
.status-panel{
  background:var(--ink);
}

.period-big{
  font-size:15px;
  font-weight:600;
  color:var(--muted);
  margin-bottom:6px;
}

.subject-big{
  font-size:34px;
  font-weight:700;
  letter-spacing:-1px;
  line-height:1.1;
  margin-bottom:16px;
}

.time-chip{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:var(--amber-dim);
  border:1px solid rgba(245,166,35,0.25);
  border-radius:6px;
  padding:6px 12px;
  font-size:12px;
  font-weight:600;
  color:var(--amber);
  font-family:var(--f-mono);
  margin-bottom:16px;
}

.next-up{
  background:var(--ink-3);
  border-radius:8px;
  padding:12px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.next-up-info{}

.next-up-lbl{
  font-size:10px;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:0.8px;
  margin-bottom:3px;
}

.next-up-subject{
  font-size:15px;
  font-weight:700;
}

.next-up-time{
  font-size:11px;
  color:var(--muted);
  margin-top:2px;
}

.countdown-pill{
  background:var(--ink);
  border:1px solid var(--line-med);
  border-radius:8px;
  padding:8px 12px;
  text-align:center;
  flex-shrink:0;
}

.countdown-val{
  font-family:var(--f-mono);
  font-size:18px;
  font-weight:700;
  color:var(--amber);
  line-height:1;
}

.countdown-lbl{
  font-size:9px;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:0.5px;
  margin-top:3px;
  font-weight:600;
}

/* ─── PROGRESS ─────────────────────────────── */
.progress-panel{}

.prog-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:10px;
}

.prog-lbl{
  font-size:12px;
  font-weight:600;
  color:var(--muted);
}

.prog-pct{
  font-size:13px;
  font-weight:700;
  color:var(--amber);
  font-family:var(--f-mono);
}

.prog-track{
  height:5px;
  background:var(--ink-3);
  border-radius:999px;
  overflow:hidden;
}

.prog-fill{
  height:100%;
  background:linear-gradient(90deg, var(--amber) 0%, #FFD180 100%);
  border-radius:999px;
  width:0%;
  transition:width 0.8s cubic-bezier(0.4,0,0.2,1);
}

.prog-times{
  display:flex;
  justify-content:space-between;
  margin-top:7px;
  font-size:10px;
  color:var(--muted-2);
  font-family:var(--f-mono);
}

/* ─── TIMETABLE ─────────────────────────────── */
.timetable-panel{
  flex:1;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  padding:20px 28px;
  border-bottom:none;
}

.tt-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:14px;
}

.tt-day{
  font-size:12px;
  color:var(--amber);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:0.8px;
}

.tt-list{
  display:flex;
  flex-direction:column;
  gap:6px;
  overflow:hidden;
}

.tt-row{
  display:grid;
  grid-template-columns:28px 1fr auto;
  align-items:center;
  gap:12px;
  padding:9px 12px;
  border-radius:8px;
  background:var(--ink-3);
  transition:background 0.2s ease, opacity 0.2s ease;
  min-height:0;
}

.tt-row.is-current{
  background:var(--amber-dim);
  border:1px solid rgba(245,166,35,0.3);
}

.tt-row.is-done{
  opacity:0.35;
}

.tt-num{
  font-size:10px;
  font-weight:700;
  color:var(--muted-2);
  font-family:var(--f-mono);
  text-align:center;
}

.tt-row.is-current .tt-num{
  color:var(--amber);
}

.tt-subj{
  font-size:13px;
  font-weight:600;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.tt-row.is-current .tt-subj{
  color:var(--amber);
}

.tt-time{
  font-size:10px;
  color:var(--muted-2);
  font-family:var(--f-mono);
  text-align:right;
  white-space:nowrap;
}

/* ─── WELCOME ANIMATION ──────────────────────── */
.welcome{
  position:fixed;
  inset:0;
  z-index:999;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--ink);
  animation:welcomeFade 3s ease 1.5s forwards;
  pointer-events:none;
}

@keyframes welcomeFade{
  0%{opacity:1}
  100%{opacity:0;visibility:hidden}
}

.welcome-inner{
  text-align:center;
  animation:welcomeIn 0.6s cubic-bezier(0.16,1,0.3,1) both;
}

@keyframes welcomeIn{
  from{opacity:0;transform:translateY(30px) scale(0.9)}
  to{opacity:1;transform:translateY(0) scale(1)}
}

.welcome-class{
  font-size:clamp(80px,14vw,180px);
  font-weight:700;
  letter-spacing:-8px;
  line-height:0.9;
  color:var(--white);
}

.welcome-class span{
  color:var(--amber);
}

.welcome-tagline{
  font-size:18px;
  color:var(--muted);
  font-weight:500;
  margin-top:20px;
  letter-spacing:0.5px;
}

/* ─── CONTENT ANIMATION ──────────────────────── */
.news-animate{
  animation:newsIn 0.4s cubic-bezier(0.16,1,0.3,1) both;
}

@keyframes newsIn{
  from{opacity:0;transform:translateY(16px)}
  to{opacity:1;transform:translateY(0)}
}

/* ─── OFFLINE BANNER ─────────────────────────── */
.offline-banner{
  position:fixed;
  bottom:20px;
  left:50%;
  transform:translateX(-50%) translateY(80px);
  background:var(--red);
  color:white;
  padding:10px 20px;
  border-radius:8px;
  font-size:13px;
  font-weight:600;
  z-index:100;
  transition:transform 0.3s ease;
}

.offline-banner.show{
  transform:translateX(-50%) translateY(0);
}

/* ─── RESPONSIVE ─────────────────────────────── */
@media(max-width:1400px){
  .board{grid-template-columns:1fr 380px}
  .news-headline{font-size:clamp(28px,3.2vw,52px)}
}
@media(max-width:1100px){
  .board{grid-template-columns:1fr 320px}
  .weather-temp{font-size:56px;letter-spacing:-3px}
  .subject-big{font-size:26px}
}
@media(max-width:860px){
  .board{
    grid-template-columns:1fr;
    grid-template-rows:72px 1fr auto;
    overflow-y:auto;
  }
  html,body{overflow:auto;height:auto}
  .news-col{height:60vw;min-height:300px}
  .sidebar{max-height:none}
  .news-headline{font-size:clamp(22px,5vw,42px)}
}
@media(max-width:600px){
  .topbar{padding:0 16px}
  .brand-name{font-size:18px}
  .clock{font-size:22px}
  .news-body{padding:24px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:0.01ms!important;
    transition-duration:0.01ms!important;
  }
}
</style>
</head>
<body>

<!-- WELCOME SCREEN -->
<div class="welcome" id="welcome" aria-hidden="true">
  <div class="welcome-inner">
    <div class="welcome-class">9<span>-E</span></div>
    <div class="welcome-tagline">Class Smartboard · Live Now</div>
  </div>
</div>

<!-- OFFLINE BANNER -->
<div class="offline-banner" id="offlineBanner">⚡ No internet — showing cached data</div>

<!-- BOARD -->
<div class="board">

  <!-- ── TOPBAR ── -->
  <header class="topbar">
    <div class="topbar-left">
      <div class="brand-pill">9-E</div>
      <div>
        <div class="brand-name">Smartboard</div>
        <div class="brand-sub">Class Dashboard · Indore</div>
      </div>
      <div class="divider-v"></div>
      <div class="live-badge">
        <span class="pulse"></span>
        Live
      </div>
    </div>
    <div class="topbar-right">
      <div class="date-display" id="dateDisplay">—</div>
      <div class="divider-v"></div>
      <div class="clock" id="clock">--:--:--</div>
    </div>
  </header>

  <!-- ── LEFT: NEWS ── -->
  <section class="news-col" aria-label="Today's news">
    <div class="news-bg" id="newsBg"></div>
    <div class="news-scrim"></div>
    <div class="news-body" id="newsBody">
      <div class="news-kicker">
        <span class="news-cat" id="newsCat">News</span>
        <span class="news-dot"></span>
        <span class="news-src" id="newsSrc">Loading</span>
      </div>
      <h2 class="news-headline" id="newsHeadline">Fetching today's top stories...</h2>
      <p class="news-desc" id="newsDesc">The smartboard pulls live headlines every 10 minutes.</p>
      <div class="news-actions">
        <a class="read-btn" id="newsLink" href="#" target="_blank" rel="noopener noreferrer">
          Read full story <span aria-hidden="true">↗</span>
        </a>
        <div class="news-counter">
          <svg class="timer-ring" viewBox="0 0 36 36">
            <circle class="timer-track" cx="18" cy="18" r="14"/>
            <circle class="timer-fill" id="timerFill" cx="18" cy="18" r="14"/>
          </svg>
          <div class="dot-track" id="dotTrack"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SIDEBAR ── -->
  <aside class="sidebar" aria-label="School info">

    <!-- WEATHER -->
    <div class="panel weather-panel">
      <div class="p-eyebrow">Indore · Live Weather</div>
      <div class="weather-row">
        <div class="weather-temp" id="wTemp">--°</div>
        <div class="weather-right">
          <span class="weather-icon-big" id="wIcon">🌤️</span>
          <div class="weather-cond" id="wCond">Loading...</div>
        </div>
      </div>
      <div class="weather-stats">
        <div class="wstat">
          <div class="wstat-val" id="wFeels">--°</div>
          <div class="wstat-lbl">Feels</div>
        </div>
        <div class="wstat">
          <div class="wstat-val" id="wHumid">--%</div>
          <div class="wstat-lbl">Humidity</div>
        </div>
        <div class="wstat">
          <div class="wstat-val" id="wWind">-- km/h</div>
          <div class="wstat-lbl">Wind</div>
        </div>
      </div>
    </div>

    <!-- SCHOOL STATUS -->
    <div class="panel status-panel">
      <div class="p-eyebrow">Now in class</div>
      <div class="period-big" id="periodLabel">—</div>
      <div class="subject-big" id="subjectBig">—</div>
      <div class="time-chip" id="timeChip">
        <span>⏱</span><span id="timeChipVal">—</span>
      </div>
      <div class="next-up">
        <div class="next-up-info">
          <div class="next-up-lbl">Up next</div>
          <div class="next-up-subject" id="nextSubject">—</div>
          <div class="next-up-time" id="nextTime">—</div>
        </div>
        <div class="countdown-pill">
          <div class="countdown-val" id="cdVal">—</div>
          <div class="countdown-lbl">in</div>
        </div>
      </div>
    </div>

    <!-- PROGRESS -->
    <div class="panel progress-panel">
      <div class="prog-header">
        <span class="prog-lbl" id="progLbl">School day</span>
        <span class="prog-pct" id="progPct">0%</span>
      </div>
      <div class="prog-track">
        <div class="prog-fill" id="progFill"></div>
      </div>
      <div class="prog-times">
        <span>7:50 AM</span>
        <span id="progEnd">1:45 PM</span>
      </div>
    </div>

    <!-- TIMETABLE -->
    <div class="timetable-panel">
      <div class="tt-header">
        <div class="p-eyebrow" style="margin:0">Today's Schedule</div>
        <div class="tt-day" id="ttDay">—</div>
      </div>
      <div class="tt-list" id="ttList"></div>
    </div>

  </aside>

</div>

<script>
(function(){
"use strict";

/* ─── DATA ─────────────────────────────────── */
const SCHEDULE = {
  monday:    ["Physics","Games","AI","Maths","Hindi","Biology","English","SST"],
  tuesday:   ["Physics","Life Skills","SST","English","Biology","English","Maths","Hindi"],
  wednesday: ["SST","Sanskrit","Maths","English","SST","Chemistry","Maths","Hindi"],
  thursday:  ["Maths","Arts","Moral Science","SST","Hindi","English","CC","CC"],
  friday:    ["Maths","AI","SST","Maths","Physics","Music/Dance","Chemistry","Hindi"],
  saturday:  ["Chemistry","SST","English","Biology","AI","Games","Maths"]
};

const PERIODS = [
  ["07:50","08:30"],["08:30","09:10"],["09:10","09:50"],["09:50","10:30"],
  ["11:05","11:45"],["11:45","12:25"],["12:25","13:05"],["13:05","13:45"]
];

const DAYS = ["sunday","monday","tuesday","wednesday","thursday","friday","saturday"];
const DAY_LABELS = {
  monday:"Monday",tuesday:"Tuesday",wednesday:"Wednesday",
  thursday:"Thursday",friday:"Friday",saturday:"Saturday"
};

// Category → contextually-correct Unsplash images
const CAT_IMAGES = {
  India: [
    "https://images.unsplash.com/photo-1524492412937-b28074a5d7da?w=1920&q=80",
    "https://images.unsplash.com/photo-1587474260584-136574528ed5?w=1920&q=80"
