/* ─── STATE ─────────────────────────────────── */
let stories = [];
let storyIdx = 0;
let newsTimer = 10;
let newsInterval = null;
let cachedNews = null;

/* ─── UTILS ─────────────────────────────────── */
const $  = id => document.getElementById(id);
const tm = t  => { const [h,m]=t.split(":").map(Number); return h*60+m; };

function fmtTime(t){
  const [h,m] = typeof t==="number"
    ? [Math.floor(t/60), t%60]
    : t.split(":").map(Number);
  const s = h>=12?"PM":"AM";
  return `${h%12||12}:${String(Math.round(m)).padStart(2,"0")} ${s}`;
}

function fmtCountdown(mins){
  if(mins<=0) return "Now";
  const m = Math.floor(mins);
  const s = Math.floor((mins%1)*60);
  return `${m}:${String(s).padStart(2,"0")}`;
}

function clean(html){
  const d = document.createElement("div");
  d.innerHTML = html;
  return (d.textContent||"").replace(/\s+/g," ").trim().slice(0,280);
}

function host(url){
  try{ return new URL(url).hostname.replace(/^www\./,""); }
  catch{ return "News"; }
}

/* ─── OFFLINE HANDLING ──────────────────────── */
function setOffline(state){
  $("offlineBanner").classList.toggle("show", state);
}

window.addEventListener("online",  ()=>{ setOffline(false); fetchNews(); fetchWeather(); });
window.addEventListener("offline", ()=>setOffline(true));

/* ─── CLOCK & DATE ──────────────────────────── */
function updateClock(){
  const now = new Date();
  $("clock").textContent = now.toLocaleTimeString("en-IN",{
    hour:"2-digit", minute:"2-digit", second:"2-digit", hour12:false
  });
  $("dateDisplay").textContent = now.toLocaleDateString("en-IN",{
    weekday:"long", day:"numeric", month:"short"
  });
}

/* ─── NEWS ──────────────────────────────────── */
const FEEDS = [
  ["India",      "https://news.google.com/rss/search?q=India+news&hl=en-IN&gl=IN&ceid=IN:en"],
  ["World",      "https://news.google.com/rss/search?q=world+news&hl=en-IN&gl=IN&ceid=IN:en"],
  ["Technology", "https://news.google.com/rss/search?q=technology+AI&hl=en-IN&gl=IN&ceid=IN:en"],
  ["Science",    "https://news.google.com/rss/search?q=science+discovery&hl=en-IN&gl=IN&ceid=IN:en"],
  ["Sports",     "https://news.google.com/rss/search?q=cricket+sports+India&hl=en-IN&gl=IN&ceid=IN:en"],
  ["Business",   "https://news.google.com/rss/search?q=business+economy+India&hl=en-IN&gl=IN&ceid=IN:en"]
];

async function fetchNews(){
  try{
    const groups = await Promise.all(FEEDS.map(([cat,url])=>
      fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(url)}`,{cache:"no-store"})
        .then(r=>r.json())
        .then(d=>{
          if(!d||!d.items) return [];
          return d.items.slice(0,4).map((item,i)=>{
            // keyword detection for better image matching
            const title = (item.title||"").toLowerCase();
            let cat2 = cat;
            if(/cricket|ipl|hockey|football|badminton|tennis/.test(title)) cat2="Sports";
            if(/ai|artificial|tech|software|app|robot/.test(title)) cat2="Technology";
            if(/health|covid|vaccine|doctor|hospital/.test(title)) cat2="Health";
            if(/modi|government|parliament|election|minister/.test(title)) cat2="Politics";

            const imgs = CAT_IMAGES[cat2] || CAT_IMAGES.India;
            return {
              title: item.title || "Untitled",
              desc:  clean(item.description||""),
              link:  item.link||"#",
              src:   host(item.link||""),
              cat:   cat2,
              img:   imgs[i % imgs.length]
            };
          });
        })
        .catch(()=>[])
    ));

    const seen = new Set();
    const all = groups.flat().filter(s=>{
      const k = s.title.toLowerCase().slice(0,40);
      if(seen.has(k)) return false;
      seen.add(k); return true;
    });

    if(all.length){
      stories = all;
      cachedNews = all;
      storyIdx = 0;
      buildDots();
      renderStory();
      startTimer();
    } else if(cachedNews){
      stories = cachedNews;
      buildDots();
      renderStory();
      startTimer();
    }
  } catch(e){
    console.warn("News fetch error:", e);
    if(cachedNews){ stories=cachedNews; buildDots(); renderStory(); startTimer(); }
  }
}

function buildDots(){
  const track = $("dotTrack");
  track.innerHTML="";
  const count = Math.min(stories.length, 12);
  for(let i=0;i<count;i++){
    const d = document.createElement("div");
    d.className="dot-item"+(i===0?" active":"");
    d.setAttribute("data-i",i);
    track.appendChild(d);
  }
}

function updateDots(){
  document.querySelectorAll(".dot-item").forEach(d=>{
    d.classList.toggle("active", +d.dataset.i === storyIdx%Math.min(stories.length,12));
  });
}

function renderStory(){
  if(!stories.length) return;
  const s = stories[storyIdx % stories.length];

  const bg = $("newsBg");
  const body = $("newsBody");

  bg.classList.remove("loaded");

  const img = new Image();
  img.onload  = ()=>{ bg.style.backgroundImage=`url("${s.img}")`; bg.classList.add("loaded"); };
  img.onerror = ()=>{ bg.style.backgroundImage=`url("${(CAT_IMAGES[s.cat]||CAT_IMAGES.India)[0]}")`; bg.classList.add("loaded"); };
  img.src = s.img;

  $("newsCat").textContent    = s.cat;
  $("newsSrc").textContent    = s.src;
  $("newsHeadline").textContent = s.title;
  $("newsDesc").textContent   = s.desc || "Tap to read the full story.";
  const link = /^https?:\/\//.test(s.link) ? s.link : "#";
  $("newsLink").href = link;

  body.classList.remove("news-animate");
  void body.offsetWidth;
  body.classList.add("news-animate");
  updateDots();
}

function startTimer(){
  clearInterval(newsInterval);
  newsTimer = 10;
  updateTimerRing(10);

  newsInterval = setInterval(()=>{
    newsTimer--;
    updateTimerRing(newsTimer);
    if(newsTimer<=0){
      storyIdx = (storyIdx+1) % stories.length;
      renderStory();
      newsTimer = 10;
    }
  }, 1000);
}

function updateTimerRing(seconds){
  const circ = 2*Math.PI*14; // r=14 → ~88
  const pct = seconds/10;
  const offset = circ*(1-pct);
  $("timerFill").style.strokeDasharray = circ;
  $("timerFill").style.strokeDashoffset = offset;
}

/* ─── WEATHER ───────────────────────────────── */
const WEATHER_CODES = {
  0:["Clear Sky","☀️"], 1:["Mainly Clear","🌤️"], 2:["Partly Cloudy","⛅"], 3:["Overcast","☁️"],
  45:["Foggy","🌫️"], 48:["Icy Fog","🌫️"], 51:["Light Drizzle","🌦️"], 53:["Drizzle","🌦️"],
  55:["Heavy Drizzle","🌧️"], 61:["Light Rain","🌦️"], 63:["Rain","🌧️"], 65:["Heavy Rain","🌧️"],
  71:["Light Snow","🌨️"], 73:["Snow","❄️"], 75:["Heavy Snow","❄️"],
  80:["Showers","🌦️"], 81:["Rain Showers","🌧️"], 82:["Heavy Showers","⛈️"],
  95:["Thunderstorm","⛈️"], 96:["Thunderstorm","⛈️"], 99:["Thunderstorm","⛈️"]
};

async function fetchWeather(){
  try{
    const r = await fetch(
      "https://api.open-meteo.com/v1/forecast?latitude=22.7196&longitude=75.8577"
      +"&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,weather_code"
      +"&timezone=Asia%2FKolkata",
      {cache:"no-store"}
    );
    const d = await r.json();
    const c = d.current;
    const [cond,icon] = WEATHER_CODES[c.weather_code] || ["Clear","☀️"];
    $("wTemp").textContent   = Math.round(c.temperature_2m)+"°";
    $("wFeels").textContent  = Math.round(c.apparent_temperature)+"°";
    $("wHumid").textContent  = c.relative_humidity_2m+"%";
    $("wWind").textContent   = Math.round(c.wind_speed_10m)+" km/h";
    $("wCond").textContent   = cond;
    $("wIcon").textContent   = icon;
  } catch(e){
    $("wCond").textContent = "Unavailable";
    console.warn("Weather error:", e);
  }
}

/* ─── TIMETABLE ─────────────────────────────── */
function getToday(){ return DAYS[new Date().getDay()]; }

function renderTimetable(){
  const day = getToday();
  const sched = SCHEDULE[day];
  const list = $("ttList");
  $("ttDay").textContent = DAY_LABELS[day] || "Today";

  if(!sched){ list.innerHTML="<div style='color:var(--muted);font-size:13px;padding:8px 0'>No school today</div>"; return; }

  list.innerHTML="";
  sched.forEach((subj,i)=>{
    const row = document.createElement("div");
    row.className="tt-row";
    row.dataset.period=i;
    row.innerHTML=`
      <span class="tt-num">${i+1}</span>
      <span class="tt-subj">${subj}</span>
      <span class="tt-time">${fmtTime(PERIODS[i][0]).replace(" AM","").replace(" PM","")}</span>
    `;
    list.appendChild(row);
  });
}

/* ─── SCHOOL STATUS & PROGRESS ──────────────── */
function updateStatus(){
  const day = getToday();
  const sched = SCHEDULE[day];

  if(!sched){
    $("periodLabel").textContent  = "Weekend";
    $("subjectBig").textContent   = "No School";
    $("timeChipVal").textContent  = "—";
    $("nextSubject").textContent  = "—";
    $("nextTime").textContent     = "Enjoy your day!";
    $("cdVal").textContent        = "—";
    $("progFill").style.width     = "0%";
    $("progPct").textContent      = "0%";
    $("progLbl").textContent      = "Weekend";
    $("ttDay").textContent        = "No school today";
    return;
  }

  const now = new Date();
  const nowM = now.getHours()*60 + now.getMinutes() + now.getSeconds()/60;

  const schoolStart = tm("07:50");
  const lunchStart  = tm("10:30");
  const lunchEnd    = tm("11:05");
  const schoolEnd   = tm(PERIODS[sched.length-1][1]);

  // ── Current Period ──
  let curIdx = -1;
  for(let i=0;i<sched.length;i++){
    if(nowM >= tm(PERIODS[i][0]) && nowM < tm(PERIODS[i][1])){ curIdx=i; break; }
  }

  // ── Next Period ──
  let nxtIdx = -1;
  if(nowM >= lunchStart && nowM < lunchEnd){
    nxtIdx = 4;
  } else {
    for(let i=0;i<sched.length;i++){
      if(nowM < tm(PERIODS[i][0])){ nxtIdx=i; break; }
    }
  }

  // ── Status text ──
  if(nowM >= schoolEnd){
    $("periodLabel").textContent = "School's over";
    $("subjectBig").textContent  = "See you tomorrow!";
    $("timeChipVal").textContent = "Done for today";
  } else if(nowM >= lunchStart && nowM < lunchEnd){
    $("periodLabel").textContent = "Break time";
    $("subjectBig").textContent  = "Lunch";
    $("timeChipVal").textContent = "Ends "+fmtTime("11:05");
  } else if(curIdx >= 0){
    $("periodLabel").textContent = "Period "+(curIdx+1)+" of "+sched.length;
    $("subjectBig").textContent  = sched[curIdx];
    $("timeChipVal").textContent = fmtTime(PERIODS[curIdx][0])+" – "+fmtTime(PERIODS[curIdx][1]);
  } else if(nowM < schoolStart){
    $("periodLabel").textContent = "School starts soon";
    $("subjectBig").textContent  = "Get Ready";
    $("timeChipVal").textContent = "First period at "+fmtTime("07:50");
  }

  // ── Next up ──
  if(nxtIdx >= 0 && nxtIdx < sched.length){
    $("nextSubject").textContent = "Period "+(nxtIdx+1)+" · "+sched[nxtIdx];
    $("nextTime").textContent    = "Starts "+fmtTime(PERIODS[nxtIdx][0]);
    const remaining = tm(PERIODS[nxtIdx][0]) - nowM;
    $("cdVal").textContent = fmtCountdown(remaining);
  } else if(nowM < schoolStart){
    $("nextSubject").textContent = "Period 1 · "+sched[0];
    $("nextTime").textContent    = "Starts "+fmtTime("07:50");
    $("cdVal").textContent       = fmtCountdown(schoolStart - nowM);
  } else {
    $("nextSubject").textContent = "No more periods";
    $("nextTime").textContent    = "—";
    $("cdVal").textContent       = "—";
  }

  // ── Progress (accounts for lunch gap correctly) ──
  let pct = 0;
  const totalMinutes = schoolEnd - schoolStart - 35; // 35 min lunch gap
  if(nowM <= schoolStart){
    pct = 0;
  } else if(nowM >= schoolEnd){
    pct = 100;
  } else {
    let elapsed = nowM - schoolStart;
    // subtract lunch if we're past it
    if(nowM > lunchEnd) elapsed -= 35;
    else if(nowM > lunchStart) elapsed -= (nowM - lunchStart);
    pct = Math.max(0, Math.min(100, (elapsed/totalMinutes)*100));
  }

  $("progFill").style.width  = pct+"%";
  $("progPct").textContent   = Math.round(pct)+"%";
  $("progEnd").textContent   = fmtTime(PERIODS[sched.length-1][1]);

  // completed periods
  const done = PERIODS.slice(0,sched.length).filter((_,i)=> nowM >= tm(PERIODS[i][1])).length;
  $("progLbl").textContent = done > 0 ? `${done} of ${sched.length} periods done` : "School day progress";

  // ── Highlight timetable ──
  document.querySelectorAll(".tt-row").forEach(row=>{
    const i = +row.dataset.period;
    row.classList.remove("is-current","is-done");
    if(i === curIdx) row.classList.add("is-current");
    else if(nowM >= tm(PERIODS[i][1])) row.classList.add("is-done");
  });
}

/* ─── MAIN TICK ─────────────────────────────── */
function tick(){
  updateClock();
  updateStatus();
}

/* ─── INIT ──────────────────────────────────── */
document.addEventListener("DOMContentLoaded",()=>{
  renderTimetable();
  tick();
  setInterval(tick, 1000);
  fetchWeather();
  setInterval(fetchWeather, 10*60*1000);
  fetchNews();
  setInterval(fetchNews, 10*60*1000);

  // hide welcome after animation
  setTimeout(()=>{
    $("welcome").style.visibility="hidden";
    $("welcome").style.pointerEvents="none";
  }, 4800);

  // check offline on load
  if(!navigator.onLine) setOffline(true);
});

